# Required in production. Create at api.slack.com/apps -> Incoming Webhooks.
# In the deployed Cloud Run job this comes from Secret Manager, never from here.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/xxxx

# Set to 1 to print the Slack payload instead of sending it.
DRY_RUN=0

# Cadence: the minimum gap between posts while quiet, and once utilization
# reaches ESCALATE_AT. This is a floor on the post rate, not the post rate
# itself -- the scheduler decides how often the bot *looks*, and this decides
# how much of that looking is allowed to reach Slack.
#
# Set it below the poll interval and it does nothing; set it above and ticks in
# between are suppressed. The deployed job runs hourly with these at 0, so
# cadence is exactly the cron. See deploy/env.yaml for why.
HEARTBEAT_HOURS=1
ESCALATED_INTERVAL_HOURS=1
ESCALATE_AT=0.79

# State. STATE_BUCKET selects the GCS store and wins over STATE_FILE; leave it
# empty for local runs and the bot uses the JSON file instead.
# STATE_BUCKET=plucky-vision-508102-k7-hl-usdc-state
STATE_OBJECT=state.json
STATE_FILE=state.json

DISPLAY_TIMEZONE=Asia/Manila
TOKEN_INDEX=0
