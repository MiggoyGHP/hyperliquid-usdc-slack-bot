# Required in production. Create at api.slack.com/apps -> Incoming Webhooks.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/xxxx

# Set to 1 to print the Slack payload instead of sending it.
DRY_RUN=0

# Cadence. Post at most every HEARTBEAT_HOURS while quiet, every
# ESCALATED_INTERVAL_HOURS once utilization reaches ESCALATE_AT.
HEARTBEAT_HOURS=1
ESCALATED_INTERVAL_HOURS=1
ESCALATE_AT=0.79

# State: set STATE_BUCKET for Cloud Run (GCS), STATE_FILE for local runs.
# STATE_BUCKET=my-project-hl-bot-state
STATE_OBJECT=state.json
STATE_FILE=state.json

DISPLAY_TIMEZONE=Asia/Manila
TOKEN_INDEX=0
