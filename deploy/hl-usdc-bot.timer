[Unit]
Description=Run the Hyperliquid USDC bot hourly

[Timer]
# Hourly at :05, matching the cron convention used by the other deploy targets.
OnCalendar=*-*-* *:05:00

# Catch up after a reboot or a suspended VM instead of silently skipping.
# The bot's own cadence logic then decides whether that tick warrants a post.
Persistent=true

# Avoid hammering the API at exactly :05 alongside everyone else.
RandomizedDelaySec=90
AccuracySec=30s

[Install]
WantedBy=timers.target
